@baseUrl = http://localhost:8000

### Get all pets
GET {{baseUrl}}/pets

### Get pets by species
GET {{baseUrl}}/pets?species=dog

### Get pets by adopted status
GET {{baseUrl}}/pets?adopted=true

### Get pets by age range
GET {{baseUrl}}/pets?minAge=1&maxAge=5

### Get pets by species + adopted + age range
GET {{baseUrl}}/pets?species=dog&adopted=false&minAge=1&maxAge=5

### Get pet by id
GET {{baseUrl}}/pets/1

### Get pet by id - not found
GET {{baseUrl}}/pets/999

### Get pet by id - invalid id (non-numeric)
GET {{baseUrl}}/pets/abc

### 404 - unknown route
GET {{baseUrl}}/unknown
